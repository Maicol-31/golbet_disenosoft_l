@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>
@{
    ViewData["Title"] = "Partidos";
    var current = ViewBag.CurrentStatus as string;
}

<h2 class="mb-4">Cartelera de partidos</h2>

<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(current) ? "btn-success" : "btn-outline-success")">Todos</a>
    <a asp-action="Index" asp-route-status="Scheduled" class="btn btn-sm @(current == "Scheduled" ? "btn-success" : "btn-outline-success")">Programados</a>
    <a asp-action="Index" asp-route-status="InProgress" class="btn btn-sm @(current == "InProgress" ? "btn-success" : "btn-outline-success")">En juego</a>
    <a asp-action="Index" asp-route-status="Finished" class="btn btn-sm @(current == "Finished" ? "btn-success" : "btn-outline-success")">Finalizados</a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var match in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        @match.Date.ToColombiaTime().ToString("ddd dd MMM · h:mm tt")
                    </small>
                    @if (match.Status == "Scheduled")
                    {
                        <span class="badge bg-primary">Programado</span>
                    }
                    else if (match.Status == "InProgress")
                    {
                        <span class="badge bg-warning text-dark">En juego</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Finalizado</span>
                    }
                </div>

                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center text-center">
                        <div class="w-100">
                            <img src="@(match.HomeTeamCrestUrl ?? "https://placehold.co")" alt="@match.HomeTeamName" width="60" height="60" class="mb-1" />
                            <div class="fw-bold small">@match.HomeTeamName</div>
                        </div>

                        <div class="px-3 text-nowrap">
                            @if (match.Status == "Finished")
                            {
                                <span class="fs-3 fw-bold">@match.HomeGoals - @match.AwayGoals</span>
                            }
                            else
                            {
                                <span class="fs-4 text-muted">vs</span>
                            }
                        </div>

                        <div class="w-100">
                            <img src="@(match.AwayTeamCrestUrl ?? "https://placehold.co")" alt="@match.AwayTeamName" width="60" height="60" class="mb-1" />
                            <div class="fw-bold small">@match.AwayTeamName</div>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <div class="row g-2 text-center mb-2">
                        <div class="col">
                            <div class="border rounded py-1">
                                <small class="text-muted d-block">1 · Local</small>
                                <span class="fw-bold">@match.HomeOdds.ToString("0.00")</span>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded py-1">
                                <small class="text-muted d-block">X · Empate</small>
                                <span class="fw-bold">@match.DrawOdds.ToString("0.00")</span>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded py-1">
                                <small class="text-muted d-block">2 · Visitante</small>
                                <span class="fw-bold">@match.AwayOdds.ToString("0.00")</span>
                            </div>
                        </div>
                    </div>
                    <a asp-action="Detail" asp-route-id="@match.Id" class="btn btn-sm btn-outline-secondary w-100">Ver detalle</a>
                </div>
            </div>
        </div>
    }
</div>