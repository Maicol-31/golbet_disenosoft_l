@using GolBet.Web.Helpers
@model GolBet.Services.DTOs.MatchDto
@{
    ViewData["Title"] = Model.HomeTeamName + " vs " + Model.AwayTeamName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Partidos</a></li>
        <li class="breadcrumb-item active">@Model.HomeTeamName vs @Model.AwayTeamName</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Model.Date.ToColombiaTime().ToString("dddd dd MMM yyyy · h:mm tt")</span>
        @if (Model.Status == "Scheduled")
        {
            <span class="badge bg-primary">Programado</span>
        }
        else if (Model.Status == "InPlay" || Model.Status == "InProgress")
        {
            <span class="badge bg-warning text-dark">En juego</span>
        }
        else
        {
            <span class="badge bg-secondary">Finalizado</span>
        }
    </div>

    <div class="card-body">
        <div class="d-flex justify-content-around align-items-center text-center py-3">
            <div>
                <img src="@(Model.HomeTeamCrestUrl ?? "https://placehold.co")" alt="@Model.HomeTeamName" width="100" height="100" class="mb-2" />
                <h4>@Model.HomeTeamName</h4>
            </div>

            <div class="px-4 text-nowrap">
                @if (Model.Status != "Scheduled")
                {
                    <span class="display-4 fw-bold">@Model.HomeGoals - @Model.AwayGoals</span>
                }
                else
                {
                    <span class="display-6 text-muted">vs</span>
                }
            </div>

            <div>
                <img src="@(Model.AwayTeamCrestUrl ?? "https://placehold.co")" alt="@Model.AwayTeamName" width="100" height="100" class="mb-2" />
                <h4>@Model.AwayTeamName</h4>
            </div>
        </div>

        <hr />

        <h5 class="text-center mb-3">Cuotas de apuestas</h5>
        <div class="row g-3 justify-content-center">
            <div class="col-md-3">
                <div class="border rounded text-center py-3">
                    <div class="text-muted">1 · @Model.HomeTeamName</div>
                    <div class="fs-3 fw-bold">@Model.HomeOdds.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded text-center py-3">
                    <div class="text-muted">X · Empate</div>
                    <div class="fs-3 fw-bold">@Model.DrawOdds.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded text-center py-3">
                    <div class="text-muted">2 · @Model.AwayTeamName</div>
                    <div class="fs-3 fw-bold">@Model.AwayOdds.ToString("0.00")</div>
                </div>
            </div>
        </div>

        @if (Model.Status == "Scheduled" && User.IsInRole("Apostador"))
        {
            <hr class="my-4" />
            <h5 class="mb-3">🎟️ Realizar apuesta</h5>
            <form asp-controller="Bets" asp-action="Place" method="post" class="row g-3 align-items-end">
                <input type="hidden" name="MatchId" value="@Model.Id" />

                <div class="col-md-4">
                    <label class="form-label fw-bold">Pronóstico</label>
                    <select name="Selection" class="form-select" required>
                        <option value="Home">1 · @Model.HomeTeamName (@Model.HomeOdds.ToString("0.00"))</option>
                        <option value="Draw">X · Empate (@Model.DrawOdds.ToString("0.00"))</option>
                        <option value="Away">2 · @Model.AwayTeamName (@Model.AwayOdds.ToString("0.00"))</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Monto (FutCoins)</label>
                    <input type="number" name="Amount" class="form-control" min="100" max="1000000" step="100" value="5000" required />
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-success w-100 fw-bold">Confirmar apuesta</button>
                </div>
            </form>
        }

        @if (User.IsInRole("Admin") && Model.Status != "Finished")
        {
            <hr class="my-4" />
            <div class="bg-light border rounded p-3">
                <h5 class="mb-3">⚙️ Panel de control del partido (Admin)</h5>
                <div class="d-flex flex-wrap gap-3 align-items-end">
                    @if (Model.Status == "Scheduled")
                    {
                        <form asp-action="Start" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-warning fw-bold">
                                ▶️ Iniciar partido (En juego)
                            </button>
                        </form>
                    }

                    <form asp-action="Finish" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label small mb-1">Goles @Model.HomeTeamName</label>
                            <input type="number" name="homeGoals" class="form-control form-control-sm" min="0" max="20" placeholder="Auto" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small mb-1">Goles @Model.AwayTeamName</label>
                            <input type="number" name="awayGoals" class="form-control form-control-sm" min="0" max="20" placeholder="Auto" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-danger btn-sm fw-bold">
                                🏁 Finalizar y liquidar apuestas
                            </button>
                        </div>
                    </form>
                </div>
                <small class="text-muted d-block mt-2">
                    Si dejas los goles vacíos, el marcador se generará aleatoriamente y pagará automáticamente a los ganadores.
                </small>
            </div>
        }
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center">
        <small class="text-muted">🎟️ @Model.TotalBets apuestas realizadas</small>
        <div>
            @if (User.IsInRole("Admin") && Model.Status == "Scheduled")
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
            }
            @if (Model.Status == "Scheduled" && !(User.Identity?.IsAuthenticated ?? false))
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-success">
                    Inicia sesión para apostar
                </a>
            }
        </div>
    </div>
</div>