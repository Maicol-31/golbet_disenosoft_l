@using System.Globalization
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@{
    ViewData["Title"] = "Cartelera de partidos";

    var culture = new CultureInfo("es-CO");
    var filters = new[] { "Todos", "Programados", "En juego", "Finalizados" };
    string currentStatus = ViewBag.CurrentStatus as string ?? "Todos";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";

    string GetTeamColor(string? teamName)
    {
        if (teamName == null) return "bg-primary";
        if (teamName.Contains("América", StringComparison.OrdinalIgnoreCase)) return "bg-danger";
        if (teamName.Contains("Nacional", StringComparison.OrdinalIgnoreCase)) return "bg-success";
        if (teamName.Contains("Cali", StringComparison.OrdinalIgnoreCase)) return "bg-success";
        if (teamName.Contains("Medellín", StringComparison.OrdinalIgnoreCase)) return "bg-danger";
        if (teamName.Contains("Santa Fe", StringComparison.OrdinalIgnoreCase)) return "bg-danger";
        if (teamName.Contains("Junior", StringComparison.OrdinalIgnoreCase)) return "bg-danger";
        if (teamName.Contains("Millonarios", StringComparison.OrdinalIgnoreCase)) return "bg-primary";
        if (teamName.Contains("Once", StringComparison.OrdinalIgnoreCase)) return "bg-primary";
        return "bg-primary";
    }

    string GetInitials(string name)
    {
        return name.Length >= 3 ? name.Substring(0, 3).ToUpper() : name.ToUpper();
    }

    string GetStatusText(string status)
    {
        return status switch
        {
            "Scheduled" => "Programado",
            "InPlay" => "En juego",
            "Finished" => "Finalizado",
            _ => status
        };
    }

    string GetStatusClass(string status)
    {
        return status switch
        {
            "Scheduled" => "bg-primary",
            "InPlay" => "bg-warning text-dark",
            "Finished" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2">⚽ Cartelera de partidos</h1>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-success" asp-action="Create">+ Nuevo partido</a>
        }
    </div>

    <div class="mb-3">
        @foreach (var f in filters)
        {
            <a asp-action="Index"
               asp-route-status="@f"
               asp-route-search="@currentSearch"
               class="btn btn-sm @(currentStatus == f ? "btn-success" : "btn-outline-success")">@f</a>
        }
    </div>

    <form method="get" asp-action="Index" class="mb-4">
        @if (currentStatus != "Todos")
        {
            <input type="hidden" name="status" value="@currentStatus" />
        }
        <div class="input-group input-group-lg shadow-sm">
            <input type="text" name="search" class="form-control"
                   placeholder="Buscar por equipo (ej. Nacional)..." value="@currentSearch" />
            <button class="btn btn-primary px-5 fw-bold" type="submit">Buscar</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center my-5">
            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <h4>No hay partidos para “@currentSearch”</h4>
            }
            else
            {
                <h4>No hay partidos disponibles</h4>
            }
            <a asp-action="Index" class="btn btn-secondary mt-3">Volver a la cartelera de partidos</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center bg-white">
                            <small class="text-muted">📅 @item.Date.ToString("ddd d MMM · h:mm tt", culture)</small>
                            <span class="badge @GetStatusClass(item.Status)">@GetStatusText(item.Status)</span>
                        </div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center text-center mb-3">
                                <div style="width: 35%;">
                                    <div class="rounded d-inline-flex align-items-center justify-content-center text-white fw-bold @GetTeamColor(item.HomeTeamName)"
                                         style="width: 60px; height: 60px;">
                                        @GetInitials(item.HomeTeamName)
                                    </div>
                                    <div class="fw-bold small mt-2">@item.HomeTeamName</div>
                                </div>

                                <div class="fw-bold fs-3">
                                    @if (item.Status == "Scheduled")
                                    {
                                        <span class="fs-6 text-muted">VS</span>
                                    }
                                    else
                                    {
                                        <span>@item.HomeGoals - @item.AwayGoals</span>
                                    }
                                </div>

                                <div style="width: 35%;">
                                    <div class="rounded d-inline-flex align-items-center justify-content-center text-white fw-bold @GetTeamColor(item.AwayTeamName)"
                                         style="width: 60px; height: 60px;">
                                        @GetInitials(item.AwayTeamName)
                                    </div>
                                    <div class="fw-bold small mt-2">@item.AwayTeamName</div>
                                </div>
                            </div>

                            <div class="row g-2 text-center">
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="small text-muted">1 · Local</div>
                                        <div class="fw-bold">@item.HomeOdds.ToString("0.00", culture)</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="small text-muted">X · Empate</div>
                                        <div class="fw-bold">@item.DrawOdds.ToString("0.00", culture)</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="small text-muted">2 · Visitante</div>
                                        <div class="fw-bold">@item.AwayOdds.ToString("0.00", culture)</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pt-0">
                            <a asp-action="Detail" asp-route-id="@item.Id"
                               class="btn btn-outline-secondary btn-sm w-100">Ver detalle</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>